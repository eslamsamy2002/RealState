# ==============================================================================
# الحمد للتسويق والاستثمار العقاري والقانوني — بورسعيد
# Environment Variables Configuration
# ==============================================================================

# Supabase Project URL (احصل عليه من Supabase -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (احصل عليه من Supabase -> Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Admin Email (البريد الإلكتروني المخصص لمدير المنصة)
VITE_ADMIN_EMAIL=admin@darestate.local
